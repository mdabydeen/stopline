{
  "name": "stopline",
  "version": "0.1.8",
  "description": "A decision gate for browser agents: Jev (or Laya) classifies each proposed action, a deterministic policy decides whether it runs.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "demo": "tsx demo/run.ts",
    "demo:revision": "tsx demo/revision-gate.ts",
    "eval": "tsx eval/run.ts",
    "test": "tsx --test src/*.test.ts eval/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm test && npm run typecheck",
    "env": "npx --yes vercel env pull .env.local --yes"
  },
  "dependencies": {
    "playwright": "^1.56.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
